# ≈ 书中的 config/nginx/default.conf.template。${SITE_DOMAIN} 在容器启动时由环境变量替换。
upstream educa {
    server web:8080;
}

# HTTP → HTTPS
server {
    listen       80;
    server_name  .${SITE_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen       443 ssl;
    http2        on;
    server_name  .${SITE_DOMAIN};          # 主域名和所有子域名（django.${SITE_DOMAIN} 这类课程子域名）
    ssl_certificate      /etc/nginx/certs/educa.crt;
    ssl_certificate_key  /etc/nginx/certs/educa.key;
    client_max_body_size 11m;              # 与 spring.servlet.multipart.max-request-size 一致
    error_log    stderr warn;
    access_log   /dev/stdout;

    # 告诉应用真实的主机名、协议和客户端 IP（应用里 server.forward-headers-strategy=native 会读取它们）
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://educa;
    }

    # WebSocket：需要把 Upgrade/Connection 头转发过去。书中转发给单独的 daphne 容器，这里是同一个应用。
    # 注意：location 里只要写了任何一条 proxy_set_header，就不再继承 server 级别的 proxy_set_header，
    # 所以 Host 和 X-Forwarded-* 必须在这里再写一遍（否则应用收到的 Host 是 "educa"，被 ALLOWED_HOSTS 检查拒绝）。
    location /ws/ {
        proxy_pass          http://educa;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "upgrade";
        proxy_set_header    Host              $host;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_read_timeout  1h;
    }

    # 用户上传的文件直接由 Nginx 返回，不经过应用。静态文件（/static/）打包在 jar 里，由应用返回并带长期缓存头
    location /media/ {
        alias /app/media/;
    }

    # 监控端点只在容器网络内部访问
    location /actuator/ {
        return 404;
    }
}

# 其他主机名（包括直接用 IP 访问）一律拒绝，≈ ALLOWED_HOSTS
server {
    listen       443 ssl default_server;
    ssl_certificate      /etc/nginx/certs/educa.crt;
    ssl_certificate_key  /etc/nginx/certs/educa.key;
    return 444;
}
